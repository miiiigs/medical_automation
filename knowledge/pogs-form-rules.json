{
  "schemaVersion": "1.0.0",
  "artifactType": "pogs-form-rules",
  "status": "ACTIVE_DRAFT",
  "purpose": {
    "summary": "Deterministic POGS web-form behavior model for field applicability, required conditions, controls, reference lists, and conditional branches.",
    "notFor": [
      "Raw patient data storage",
      "AI-generated clinical truth",
      "Guessing POGS reference IDs",
      "POGS cloud submission automation"
    ]
  },
  "sourcePolicy": {
    "primary": "POGS frontend validation/reference-data source supplied during reverse engineering",
    "preserveFrontendBehavior": true,
    "doNotInventMissingRules": true,
    "pinToRunningPogsBuildBeforeProduction": true
  },
  "ruleSemantics": {
    "states": [
      "exists",
      "applicable",
      "visible",
      "required",
      "satisfied"
    ],
    "conditionOperators": {
      "eq": "exact equality including false/null",
      "in": "membership in a set",
      "truthy": "nonzero/nonfalse value",
      "all": "all conditions must pass"
    },
    "booleanValidation": "false is a valid populated boolean; null/undefined is missing",
    "numericValidation": "zero is valid numeric content; apply range/integer constraints separately",
    "important": "Stored field existence does not imply current applicability, visibility, or requirement."
  },
