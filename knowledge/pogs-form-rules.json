  "engineRules": {
    "requiredEvaluation": "Field is required when closeCaseRequired=true or requiredWhen evaluates true.",
    "applicabilityEvaluation": "Use applicableWhen if present. A conditional required field is applicable when its condition is true.",
    "arrayValidation": "Apply minItems to arrays/objects when applicable.",
    "booleanValidation": "false is valid; only null/undefined is missing.",
    "numericValidation": "0 is valid; then enforce min/max/integer.",
    "neonatalValidation": "When neonatal is required and infantsNumber>0, validate the first infantsNumber records; anomalyOthers only becomes required when anomalies=true.",
    "referenceIntegrity": "Only confirmed POGS reference IDs may be emitted.",
    "regressionSafety": "REGRESSION may evaluate rules but must never call live POGS writes."
  },
  "knownGaps": [
    {
      "area": "visibility-vs-required",
      "status": "PARTIAL",
      "detail": "Close-case required conditions are strongly confirmed. Not every visual show/hide branch was independently extracted."
    },
    {
      "area": "full reference dictionaries",
      "status": "SEPARATE_ARTIFACT_RECOMMENDED",
      "detail": "Large hierarchical diagnosis, morbidity, history, and procedure dictionaries should be exported to pogs-reference-values.json instead of duplicating all entries here."
    },
    {
      "area": "pediatric-range-specific conditional fields",
      "status": "NOT_CONFIRMED",
      "detail": "Neonatal fields and completion rules are confirmed, but an exact age/gestational-range condition that reveals additional pediatric fields was not established from the supplied source. Do not invent a threshold."
    },
    {
      "area": "pregnancyType=2/isHeterotopic",
      "status": "SOURCE_CONFLICT_REVIEW_REQUIRED",
      "detail": "Static pregnancyType option 2 is Multiple Pregnancy while frontend validation requires isHeterotopic for pregnancyType=2. Verify against the running build."
    },
    {
      "area": "COVID dropdown options",
      "status": "NOT_FULLY_EXTRACTED",
      "detail": "Conditional behavior is confirmed; complete option dictionaries are not yet confirmed."
    },
    {
      "area": "frontend variants",
      "status": "PIN_BUILD_BEFORE_PRODUCTION",
      "detail": "Supplied bundles show small validation differences. Rules should be verified against the exact running POGS frontend build."
    }
  ],
  "implementation": {
    "recommendedPath": "/data/knowledge/pogs-form-rules.json",
    "companionReferenceFile": "/data/knowledge/pogs-reference-values.json",
    "n8nFlow": [
      "Parse Clinical Sections",
      "Classify / AI-assisted fact extraction",
      "Map clinical concepts using semantic layer",
      "Load POGS Form Rules",
      "Apply POGS Form Rules",
      "Build POGS Candidate",
      "Validate applicable required fields",
      "Knowledge & Regression",
      "Only LIVE + readyForPOGS may invoke local POGS Processing"
    ]
  }
}