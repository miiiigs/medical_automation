      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const record = $json;\n\nconst content =\n  JSON.stringify(\n    record,\n    null,\n    2\n  );\n\nreturn {\n  json: {\n    rawCaseId:\n      record.rawCaseId,\n\n    fileName:\n      `${record.rawCaseId}.json`\n  },\n\n  binary: {\n    data: {\n      data:\n        Buffer.from(\n          content,\n          \"utf8\"\n        )\n        .toString(\"base64\"),\n\n      mimeType:\n        \"application/json\",\n\n      fileName:\n        `${record.rawCaseId}.json`\n    }\n  }\n};"
