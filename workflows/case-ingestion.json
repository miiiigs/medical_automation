      "parameters": {
        "jsCode": "const rows =\n  $json.sheets?.[0]\n    ?.data?.[0]\n    ?.rowData ?? [];\n\nconst results = [];\n\nfor (let i = 0; i < rows.length; i++) {\n  const cell =\n    rows[i]?.values?.[0];\n\n  const uri =\n    cell\n      ?.chipRuns?.[0]\n      ?.chip\n      ?.richLinkProperties\n      ?.uri;\n\n  if (!uri) continue;\n\n  const match =\n    uri.match(/\\/document\\/d\\/([^/]+)/);\n\n  if (!match) continue;\n\n  results.push({\n    json: {\n      sourceRowOffset: i,\n      documentUrl: uri,\n      documentId: match[1]\n    }\n  });\n}\n\nreturn results;"
      },
